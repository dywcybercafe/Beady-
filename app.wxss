page {
  min-height: 100%;
  background: #f7f7fb;
  color: #20202a;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button,
input {
  font: inherit;
}

button::after {
  border: 0;
}

.safe-top {
  height: env(safe-area-inset-top);
}
