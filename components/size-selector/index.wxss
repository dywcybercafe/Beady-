.card { padding: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 10rpx 40rpx rgba(52, 45, 90, .06); }
.section-heading { display: flex; align-items: center; gap: 18rpx; margin-bottom: 24rpx; }
.heading-icon { flex: none; width: 56rpx; height: 56rpx; border-radius: 16rpx; }
.heading-title { display: block; font-size: 30rpx; line-height: 1.2; font-weight: 700; }
.heading-caption { display: block; margin-top: 7rpx; color: #9a99a6; font-size: 22rpx; }
.preset-grid { display: grid; grid-template-columns: repeat(2, 196rpx); justify-content: center; column-gap: 32rpx; row-gap: 20rpx; }
.option-button { width: 196rpx; height: 74rpx; padding: 0; border: 2rpx solid transparent; border-radius: 21rpx; background: #f7f7fa; color: #292a33; font-size: 26rpx; line-height: 74rpx; }
.option-button.is-selected { border-color: #7458ff; background: linear-gradient(135deg, #f7f3ff, #f1efff); color: #6549f7; font-weight: 650; box-shadow: inset 0 0 0 1rpx rgba(116,88,255,.12); }
.custom-panel { margin-top: 24rpx; overflow: hidden; border: 2rpx solid transparent; border-radius: 22rpx; background: #f7f7fa; }
.custom-panel.is-open { border-color: #e4ddff; background: #fbfaff; }
.custom-trigger { box-sizing: border-box; height: 82rpx; padding: 0 24rpx; display: flex; align-items: center; justify-content: space-between; color: #34343e; }
.is-open .custom-trigger { color: #6d52f7; font-weight: 650; }
.chevron { font-size: 36rpx; color: #7b65f4; }
.custom-content { padding: 4rpx 20rpx 22rpx; }
.dimension-row { display: flex; align-items: flex-end; gap: 14rpx; }
.field { flex: 1; color: #5f5f6b; font-size: 23rpx; }
.field input { box-sizing: border-box; height: 78rpx; margin-top: 10rpx; padding: 0 20rpx; border: 2rpx solid #eceaf3; border-radius: 20rpx; background: #fff; color: #262631; font-size: 28rpx; }
.times { padding-bottom: 21rpx; color: #a3a1ad; }
.lock-row { margin-top: 24rpx; display: flex; align-items: center; justify-content: space-between; }
.lock-title { display: block; color: #33333d; font-size: 26rpx; }
.lock-tip { display: block; margin-top: 6rpx; color: #a09daa; font-size: 20rpx; }
.switch { position: relative; flex: none; width: 86rpx; height: 48rpx; border-radius: 28rpx; background: #dedde4; transition: background .2s; }
.switch-knob { position: absolute; top: 5rpx; left: 5rpx; width: 38rpx; height: 38rpx; border-radius: 50%; background: #fff; box-shadow: 0 3rpx 10rpx rgba(35,30,60,.18); transition: transform .2s; }
.switch.switch-on { background: linear-gradient(135deg, #7655ff, #6550ed); }
.switch-on .switch-knob { transform: translateX(38rpx); }
