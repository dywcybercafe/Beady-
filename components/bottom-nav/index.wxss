.nav-shell { position: fixed; z-index: 20; left: 0; right: 0; bottom: 0; padding: 12rpx 28rpx calc(12rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); box-shadow: 0 -8rpx 30rpx rgba(58,49,97,.07); }
.nav-inner { height: 104rpx; display: flex; justify-content: space-around; }
.nav-item { width: 180rpx; border-radius: 26rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: #777986; font-size: 20rpx; }
.nav-item.is-active { background: linear-gradient(145deg, #f4f0ff, #faf8ff); color: #674cf2; font-weight: 650; }
.nav-icon { position: relative; width: 46rpx; height: 42rpx; color: currentColor; }
.roof { position: absolute; left: 7rpx; top: 1rpx; width: 30rpx; height: 30rpx; border-left: 6rpx solid currentColor; border-top: 6rpx solid currentColor; border-radius: 5rpx; transform: rotate(45deg); }
.house { position: absolute; left: 9rpx; bottom: 1rpx; width: 31rpx; height: 25rpx; border-radius: 4rpx; background: currentColor; }
.door { position: absolute; z-index: 2; left: 21rpx; bottom: 1rpx; width: 9rpx; height: 15rpx; border-radius: 4rpx 4rpx 0 0; background: #fff; }
.folder-tab { position: absolute; left: 4rpx; top: 5rpx; width: 21rpx; height: 10rpx; border: 4rpx solid currentColor; border-bottom: 0; border-radius: 5rpx 5rpx 0 0; }
.folder-body { position: absolute; left: 3rpx; bottom: 2rpx; box-sizing: border-box; width: 42rpx; height: 30rpx; border: 4rpx solid currentColor; border-radius: 6rpx; }
.sparkle-icon { height: 48rpx; font-size: 52rpx; line-height: 42rpx; font-weight: 400; text-align: center; }
